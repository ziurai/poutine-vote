# Copy to .env.local and fill in. Never commit .env.local.
# Note: `vercel env pull` does NOT work here - it returns encrypted values as
# empty strings. Copy these from the Vercel dashboard or ask Alex.

# Supabase. Required - the site will not render without these.
# NEXT_PUBLIC_ means these are bundled into the browser, so they are not
# secrets; row-level security on the Supabase side is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mailchimp. Only needed to work on /api/subscribe (the email capture on
# sign-in). Everything else runs fine without them; the route just 500s.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=
